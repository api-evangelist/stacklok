{
  "opencollection": "1.0.0",
  "info": {
    "name": "ToolHive Registry clients secrets API",
    "version": "0.1"
  },
  "items": [
    {
      "info": {
        "name": "secrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Setup or reconfigure secrets provider",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1beta/secrets",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Setup the secrets provider with the specified type and configuration."
        },
        {
          "info": {
            "name": "Get secrets provider details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1beta/secrets/default"
          },
          "docs": "Get details of the default secrets provider"
        },
        {
          "info": {
            "name": "List secrets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1beta/secrets/default/keys"
          },
          "docs": "Get a list of all secret keys from the default provider"
        },
        {
          "info": {
            "name": "Create a new secret",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1beta/secrets/default/keys",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new secret in the default provider (encrypted provider only)"
        },
        {
          "info": {
            "name": "Update a secret",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1beta/secrets/default/keys/:key",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "path",
                "description": "Secret key"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing secret in the default provider (encrypted provider only)"
        },
        {
          "info": {
            "name": "Delete a secret",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1beta/secrets/default/keys/:key",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "path",
                "description": "Secret key"
              }
            ]
          },
          "docs": "Delete a secret from the default provider (encrypted provider only)"
        }
      ]
    }
  ],
  "bundled": true
}
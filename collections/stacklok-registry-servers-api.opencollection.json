{
  "opencollection": "1.0.0",
  "info": {
    "name": "ToolHive Registry clients registry-servers API",
    "version": "0.1"
  },
  "items": [
    {
      "info": {
        "name": "registry-servers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List available registry servers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/registry/:registryName/v0.1/servers",
            "params": [
              {
                "name": "registryName",
                "value": "",
                "type": "path",
                "description": "Registry name (currently ignored, uses the default provider)"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search filter — matches against server name and description"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number, 1-based (default: 1)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Items per page, max 200 (default: 50)"
              }
            ]
          },
          "docs": "Get a paginated list of servers from the registry. Supports optional full-text search and pagination."
        },
        {
          "info": {
            "name": "Get a registry server",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/registry/:registryName/v0.1/servers/:serverName/versions/latest",
            "params": [
              {
                "name": "registryName",
                "value": "",
                "type": "path",
                "description": "Registry name (currently ignored, uses the default provider)"
              },
              {
                "name": "serverName",
                "value": "",
                "type": "path",
                "description": "Server name (URL-encoded reverse-DNS format)"
              }
            ]
          },
          "docs": "Retrieve a single server by name. Names use reverse-DNS format; URL-encode slashes."
        }
      ]
    }
  ],
  "bundled": true
}